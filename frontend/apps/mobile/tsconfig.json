{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2017",
    "lib": [
      "ES2017"
    ],
    "jsx": "react-native",
    "noEmit": true,
    "paths": {
      "@passion-market/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@passion-market/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@passion-market/hooks": [
        "../../packages/hooks/src/index.ts"
      ],
      "@passion-market/hooks/*": [
        "../../packages/hooks/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
